{
  "name": "oziq-ovqat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "prestart": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$ports = 4000,4102,5173,5174,5175,5176; Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Where-Object { $_.LocalPort -in $ports } | ForEach-Object { try { Stop-Process -Id $_.OwningProcess -Force -ErrorAction Stop } catch {} }\"",
    "start": "concurrently \"npm run dev\" \"json-server --watch db.json --port 4000\" \"node upload-server.js\"",
    "start:api": "json-server db.json --port ${PORT:-4000} --host 0.0.0.0",
    "start:upload": "node upload-server.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "json-server": "^1.0.0-beta.15",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
